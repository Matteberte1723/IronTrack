rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ogni utente può leggere e scrivere solo il proprio documento
    // Ma tutti gli utenti autenticati possono LEGGERE (per ricerca amici)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Richieste di amicizia: leggibili da mittente o destinatario, creabili da chiunque loggato
    match /friendRequests/{reqId} {
      allow read: if request.auth != null &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Lista amici: subcollection, gestita dal proprietario
    // Ma anche il mittente può scrivere nella lista dell'amico (quando viene accettata la richiesta)
    match /friends/{userId}/list/{friendId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == friendId);
    }

    // Sfide: leggibili da mittente o destinatario, creabili da chiunque loggato
    match /challenges/{challengeId} {
      allow read: if request.auth != null &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
  }
}
